/var/log/pihole/pihole.log {
    # su #
    daily
    create 640 pihole pihole
    rotate 5
    compress
    delaycompress
    notifempty
    nomail
    postrotate
        # Only signal a strictly numeric PID. The PID file is pihole-owned and
        # writable; unquoted $(cat ...) previously allowed signal injection as root.
        # See getFTLPID() in utils.sh / GHSA-6w8x-p785-6pm4 follow-up.
        pid="$(cat /run/pihole-FTL.pid 2>/dev/null)" || true
        case "${pid}" in
            ''|*[!0-9]*) ;;
            *) kill -USR2 -- "${pid}" 2>/dev/null || true ;;
        esac
    endscript
}

# FTL.log and webserver.log are opened and closed for each line, therefore no postrotate is needed
/var/log/pihole/FTL.log {
    # su #
    weekly
    create 640 pihole pihole
    rotate 3
    compress
    delaycompress
    notifempty
    nomail
}

/var/log/pihole/webserver.log {
    # su #
    weekly
    create 640 pihole pihole
    rotate 3
    compress
    delaycompress
    notifempty
    nomail
}
